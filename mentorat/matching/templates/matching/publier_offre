<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Publier une offre</title>
</head>
<body>
    <h1>Publier une offre de mentorat</h1>

    <form method="POST">
        {% csrf_token %}

        <label>Type :</label>
        <select name="type">
            <option value="offre">Offre</option>
            <option value="demande">Demande</option>
        </select>
        <br><br>

        <label>Compétence (ID) :</label>
        <input type="number" name="competence_id">
        <br><br>

        <label>Format :</label>
        <select name="format">
            <option value="presentiel">Présentiel</option>
            <option value="en_ligne">En ligne</option>
            <option value="les_deux">Les deux</option>
        </select>
        <br><br>

        <label>Description :</label>
        <textarea name="description"></textarea>
        <br><br>

        <button type="submit">Publier</button>
    </form>

    <a href="{% url 'recherche_mentor' %}">Retour</a>
</body>
</html>